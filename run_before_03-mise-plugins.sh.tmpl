function _check_and_add() {
  # $1 = name
  # $2 = url
  local plugin_data=$(mise registry $1 --json)
  local plugin_url=$(echo $plugin_data | jq .)

  if [ -z "${1}" ]; then
    echo "NAME is missing"
    return 1
  fi

  if [ -z "${2}" ]; then
    echo "URL is missing"
    return 1
  fi

  mise plugins list | grep "${1}" 2>&1 >/dev/null
  local RET=$?

  if [ $RET -eq 1 ]; then
    echo -e "\033[1;33m\033[0m Adding plugin \033[1;32m${1}\033[0m with URL \033[1;36m${2}\033[0m \033[1;35m󱞣 \033[0m"
    mise plugins add "${1}" "${2}"
    echo ""
  else
    # echo -e "\033[1;32m\033[0m Plugin \033[1m${1}\033[0m is already enabled"
    echo -e "\033[1;32m\033[0m Plugin \033[1m${1}\033[0m is already enabled"
  fi
}

_check_and_add "lua" "https://github.com/mise-plugins/vfox-lua.git"
_check_and_add "op" "https://github.com/mise-plugins/vfox-1password.git"
