{{- if or (eq .chezmoi.os "darwin") (eq .chezmoi.os "linux") -}}
#!/bin/bash
# Generate bob shell completions for fish
source "${CHEZMOI_SOURCE_DIR}/.shlibs/sh/logging.sh"

set -e

FISH_COMPLETIONS_DIR="${HOME}/.config/fish/completions"

# Find bob - check common locations
if command -v bob &>/dev/null; then
    BOB="bob"
elif [ -x "/opt/homebrew/bin/bob" ]; then
    BOB="/opt/homebrew/bin/bob"
elif [ -x "${HOME}/.local/bin/bob" ]; then
    BOB="${HOME}/.local/bin/bob"
else
    r35_log_warn "\033[1mbob\033[0m not found, skipping completions."
    exit 0
fi

mkdir -p "$FISH_COMPLETIONS_DIR"

r35_log_header "Generating bob fish completions..."
"$BOB" complete fish > "${FISH_COMPLETIONS_DIR}/bob.fish"

r35_log_ok "\033[1mbob\033[0m fish completions installed"
{{ end -}}
