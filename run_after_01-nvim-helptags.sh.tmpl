{{- if or (eq .chezmoi.os "darwin") (eq .chezmoi.os "linux") -}}
#!/bin/bash
# Rebuild Neovim's help tags for this config's own doc/ directory.
#
# doc/tags is generated by :helptags and deliberately not versioned (see
# .chezmoiignore), so a fresh apply lands doc/*.txt with no tags file at all and
# `:help r35-glyphs` fails with E149. lazy.nvim builds tags for every plugin it
# manages, but ~/.config/nvim is not a managed plugin, so nothing else does it.
#
# run_after_ specifically: plain run_ scripts execute in ASCII order *with
# respect to* file updates, so one could fire before doc/*.txt is written.
# run_after_ is guaranteed to run once every file has landed.
#
# The BufWritePost autocmd in lua/config/autocmds.lua covers the other
# direction -- editing a help file locally, where no apply ever happens.

source "${CHEZMOI_SOURCE_DIR}/.shlibs/sh/logging.sh"
DOC="${HOME}/.config/nvim/doc"

if ! command -v nvim &>/dev/null; then
    r35_log_warn "\033[1mnvim\033[0m not found, skipping helptags"
    exit 0
fi

if [ ! -d "$DOC" ]; then
    r35_log_info "\033[1m${DOC}\033[0m directory doesn't exist.  Skipping."
    exit 0
fi

# --clean so a broken plugin or a half-applied config cannot fail the apply.
# :helptags takes an explicit path, so runtimepath is irrelevant here.
if nvim --headless --clean -c "helptags ${DOC}" -c 'qa!' </dev/null 2>/dev/null; then
    r35_log_ok "rebuilt nvim helptags in ${DOC}"
else
    # Never fail the apply over documentation.
    r35_log_error "helptags failed for ${DOC}"
fi
{{ end -}}
