{{- if or (eq .chezmoi.os "darwin") (eq .chezmoi.os "linux") -}}
#!/bin/bash
source "${CHEZMOI_SOURCE_DIR}/.shlibs/sh/logging.sh"
# Install mise (https://mise.jdx.dev) if not already installed

set -e

if command -v mise &>/dev/null; then
    r35_log_ok "mise is already installed: $(mise --version)"
    exit 0
fi

if [ -x "$HOME/.local/bin/mise" ]; then
    r35_log_ok "mise is already installed at ~/.local/bin/mise"
    exit 0
fi

r35_log_header "Installing mise..."
curl -fsSL https://mise.run | sh

r35_log_ok "mise installed successfully"
{{ end -}}
