# |> Using Special Backends
# ==> golang backend
"go:golang.org/x/tools/gopls" = "latest"
"go:github.com/picatz/doh" = "latest"

# ==> npm backend
"npm:neovim" = "latest"
# NOTE: using mise doesn't play nice with `pi update`.  Use the package direct from `npm`.
# npm install -g --allow-scripts=esbuild,@google/genai,protobufjs @earendil-works/pi-coding-agent@latest
# "npm:@earendil-works/pi-coding-agent" = "latest"
"npm:@rivolink/leaf" = "latest"
"npm:mcp-hub" = "latest"
"npm:npm" = "latest"

# ==> gem backend
"gem:neovim" = "latest"

# ==> gitlab release backend
"gitlab:gitlab-org/cli" = "latest"

# ==> github release backend
"github:aubepkg/aube" = "latest" # We can't use the aqua backend for Aube because it's failing on cert signing shenanigans

# ==> cargo backend
"cargo:grip-grab" = "latest"

[settings]
idiomatic_version_file_enable_tools = ["node"]

