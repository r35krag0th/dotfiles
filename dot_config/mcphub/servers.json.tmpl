{{/* vim: set ft=json.chezmoitmpl: */}}
{{/* NOTE: The vast majority of MCP traffic is going through LiteLLM */}}
{
  "mcpServers": {
    "k8s-mcp": {
      "args": [
        "-y",
        "kubernetes-mcp-server@latest"
      ],
      "command": "npx"
    },
    "memory": {
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "command": "npx"
    },
    "litellm": {
      "url": "https://litellm.r35.dev/mcp/"
    }
  }
}
